CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC79_DEVKITBOARD=y
CONFIG_JIELI_CAMERA_PATH_SPI=y
CONFIG_ENABLE_CAMERA=y
CONFIG_ENABLE_DVP=y
CONFIG_JIELI_BOARD_CAMERA_WIDTH=640
CONFIG_JIELI_BOARD_CAMERA_HEIGHT=480
CONFIG_JIELI_BOARD_CAMERA_FPS=12
CONFIG_EXAMPLE_CAMERA_WIDTH=640
CONFIG_EXAMPLE_CAMERA_HEIGHT=480
CONFIG_EXAMPLE_CAMERA_FPS=12
# GC0310 sampling edge. The vendor DevKitBoard board file hardcodes SMPH; the
# wifi_camera board says SMPL. Measured on the devkit here: SMPL shifts the
# packet tags (first bytes arrive as fc0002af/f2a5fea6), SMPH decodes ff0000ab.
# CONFIG_JIELI_CAMERA_SPI_EDGE_SMPL is not set
CONFIG_JIELI_CAMERA_SPI_EDGE_SMPH=y
# Diagnostic: scan iic1 (software IIC on PH0/PH1) before video1 sensor checks.
CONFIG_JIELI_CAMERA_I2C_SCAN=y
# CONFIG_ENABLE_MEDIA is not set
CONFIG_JIELI_UART_LOG_PORT=1
CONFIG_JIELI_UART_LOG_BAUDRATE=115200
