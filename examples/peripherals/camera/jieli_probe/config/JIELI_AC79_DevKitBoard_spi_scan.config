CONFIG_BOARD_CHOICE_JIELI=y
CONFIG_BOARD_CHOICE_AC79_DEVKITBOARD=y
CONFIG_JIELI_CAMERA_PATH_SPI=y
CONFIG_ENABLE_CAMERA=y
CONFIG_ENABLE_DVP=y
CONFIG_JIELI_BOARD_CAMERA_WIDTH=320
CONFIG_JIELI_BOARD_CAMERA_HEIGHT=240
CONFIG_JIELI_BOARD_CAMERA_FPS=12
CONFIG_EXAMPLE_CAMERA_WIDTH=320
CONFIG_EXAMPLE_CAMERA_HEIGHT=240
CONFIG_EXAMPLE_CAMERA_FPS=12
# GC0310 sampling edge per wifi_camera/board/wl82/board_dev_kit_cfg.h.
# The vendor demo_DevKitBoard board file instead hardcodes SMPH; switch this
# symbol back to CONFIG_JIELI_CAMERA_SPI_EDGE_SMPH for that module.
CONFIG_JIELI_CAMERA_SPI_EDGE_SMPL=y
# Diagnostic: scan iic1 (software IIC on PH0/PH1) before video1 sensor checks.
CONFIG_JIELI_CAMERA_I2C_SCAN=y
# CONFIG_ENABLE_MEDIA is not set
CONFIG_JIELI_UART_LOG_PORT=1
CONFIG_JIELI_UART_LOG_BAUDRATE=115200
