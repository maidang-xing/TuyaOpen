menu "configure Jieli wl82"

config JIELI_MINIMAL_HELLO
    bool "Jieli minimal UART hello image"
    default y
    help
        Keep the vendor bridge on the minimal UART image. Disable this for
        applications that need the complete TuyaOpen component graph.

config PLATFORM_JIELI
    bool
    default y

config OPERATING_SYSTEM
    int
    default 98
    ---help---
        98      /* RTOS */

config LITTLE_END
    int
    default 1

config ENABLE_UART
    bool "ENABLE_UART --- use UART output"
    default y

config LOG_UART_PORT
    int "Jieli log UART port"
    default 0
    range 0 5

config LOG_UART_BAUDRATE
    int "Jieli log UART baudrate"
    default 115200
    range 1200 4000000

config ENABLE_WIFI
    bool "ENABLE_WIFI --- use Wi-Fi"
    default n

config ENABLE_BLUETOOTH
    bool "ENABLE_BLUETOOTH --- use Bluetooth"
    default n

endmenu
