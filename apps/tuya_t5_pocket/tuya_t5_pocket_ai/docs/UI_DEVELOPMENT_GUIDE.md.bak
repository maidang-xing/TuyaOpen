## 5. 最佳实践

### 5.1 内存管理

```c
void my_screen_deinit(void)
{
    // 1. 先移除事件回调
    if (ui_my_screen) {
        lv_obj_remove_event_cb(ui_my_screen, keyboard_event_cb);
        lv_group_remove_obj(ui_my_screen);
    }
    
    // 2. 删除定时器
    if (timer) {
        lv_timer_del(timer);
        timer = NULL;
    }
    
    // 3. 释放动态内存
    if (my_data) {
        free(my_data);
        my_data = NULL;
    }
}
```

### 5.2 状态保存与恢复

```c
typedef struct {
    int selected_index;
    char text[128];
} MyScreenState_t;

static MyScreenState_t *state = NULL;

void my_screen_init(void)
{
    // 恢复或创建状态
    if (my_screen.state_data) {
        state = (MyScreenState_t *)my_screen.state_data;
    } else {
        state = malloc(sizeof(MyScreenState_t));
        state->selected_index = 0;
        my_screen.state_data = state;
    }
    
    // 使用状态初始化UI
    // ...
}
```

### 5.3 定时器使用

```c
static void update_timer_cb(lv_timer_t *timer)
{
    static int counter = 0;
    counter++;
    
    lv_label_set_text_fmt(label, "Count: %d", counter);
    
    if (counter >= 100) {
        lv_timer_pause(timer);
    }
}

void my_screen_init(void)
{
    // 创建周期定时器（500ms）
    timer = lv_timer_create(update_timer_cb, 500, NULL);
}
```

### 5.4 键盘事件模板

```c
static void keyboard_event_cb(lv_event_t *e)
{
    uint32_t key = lv_event_get_key(e);
    
    switch (key) {
        case KEY_UP:
            if (selected_index > 0) {
                selected_index--;
                update_selection();
            }
            break;
            
        case KEY_DOWN:
            if (selected_index < MAX_ITEMS - 1) {
                selected_index++;
                update_selection();
            }
            break;
            
        case KEY_ENTER:
            confirm_selection();
            break;
            
        case KEY_ESC:
            screen_back();
            break;
    }
}
```

### 5.5 动画效果

```c
void my_screen_init(void)
{
    lv_obj_t *label = lv_label_create(ui_my_screen);
    lv_obj_set_style_opa(label, LV_OPA_TRANSP, 0);
    
    // 淡入动画
    lv_anim_t a;
    lv_anim_init(&a);
    lv_anim_set_var(&a, label);
    lv_anim_set_values(&a, LV_OPA_TRANSP, LV_OPA_COVER);
    lv_anim_set_time(&a, 500);
    lv_anim_set_exec_cb(&a, (lv_anim_exec_xcb_t)lv_obj_set_style_opa);
    lv_anim_start(&a);
}
```

