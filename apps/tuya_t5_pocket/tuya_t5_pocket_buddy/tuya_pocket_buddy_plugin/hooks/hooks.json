{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "diff -q \"${CLAUDE_PLUGIN_ROOT}/package.json\" \"${CLAUDE_PLUGIN_DATA}/package.json\" >/dev/null 2>&1 || (cd \"${CLAUDE_PLUGIN_DATA}\" && cp \"${CLAUDE_PLUGIN_ROOT}/package.json\" \"${CLAUDE_PLUGIN_ROOT}/tsconfig.json\" . && cp -r \"${CLAUDE_PLUGIN_ROOT}/src\" . && npm install && npm run build && echo 'tuya-pocket-buddy: build complete') || rm -f \"${CLAUDE_PLUGIN_DATA}/package.json\""
          },
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/scripts/hook_handler.js\""
          }
        ]
      }
    ]
  }
}
