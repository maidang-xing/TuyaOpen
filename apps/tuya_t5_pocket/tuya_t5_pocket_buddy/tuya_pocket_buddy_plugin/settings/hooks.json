{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "curl -s -X POST http://127.0.0.1:9878/hook -d @- -H 'Content-Type: application/json' --max-time 3 || true"
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node tuya_pocket_buddy_plugin/scripts/hook_handler.js"
      }
    ]
  }
}
